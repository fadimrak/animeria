# Animeria Environment Configuration Template
# Copy this file to .env and adjust values for your environment

# Server Port (Default: 3000)
PORT=3000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# Security Secrets (Must be unique, strong random strings in production)
# Generate random keys: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_strong_random_jwt_secret_in_production
SESSION_SECRET=replace_with_strong_random_session_secret_in_production

# CORS Allowed Origins (Comma-separated URLs for production domain)
# Example: https://animeria.example.com,https://api.example.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
